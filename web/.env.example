# Copy to web/.env.local. The website never holds keys: only these settings.

# anvil | base-sepolia (selects ../contracts/deployments/<NETWORK>.json)
NETWORK=anvil

# RPC for anvil (or any network other than base-sepolia)
RPC_URL=http://127.0.0.1:8545

# RPC for NETWORK=base-sepolia
# BASE_SEPOLIA_RPC=https://sepolia.base.org

# Agent HTTP API (agent: npm run serve)
AGENT_API_URL=http://127.0.0.1:8787

# Agent the arena talks to (e.g. one on an anvil fork). Default: AGENT_API_URL
# ARENA_AGENT_API_URL=

# 1 only behind a reverse proxy that appends the client address to X-Forwarded-For
# TRUST_PROXY=

# What the arena QR code points to. Default: the request origin + /arena.
# Set it when presenting from a laptop, e.g. http://192.168.1.20:3000/arena
# PUBLIC_ARENA_URL=
