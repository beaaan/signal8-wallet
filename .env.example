# ---- chain ----
NETWORK=base-sepolia
BASE_SEPOLIA_RPC=https://sepolia.base.org
CHAIN_ID=84532

# ---- Safe ----
SAFE_ADDRESS=
SAFE_API_KEY=            # from developer.safe.global (Transaction Service, Base Sepolia)

# ---- keys (testnet only; each person holds only what their area needs) ----
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
GUARDIAN_PRIVATE_KEY=
HKO_RELAYER_PRIVATE_KEY=
GDACS_RELAYER_PRIVATE_KEY=
DEMO_CLIENT_PRIVATE_KEY=  # simulated customer paying invoices into PaymentRouter (replay only)
# `npm run keys:new` in agent/ fills the agent, relayer and demo client keys and prints the addresses to fund.

# ---- addresses the deploy script needs off Anvil (Safe owners and guardian keep their own keys) ----
OWNER_ADDRESS=
AGENT_ADDRESS=
GUARDIAN_ADDRESS=
HKO_RELAYER_ADDRESS=
GDACS_RELAYER_ADDRESS=
DEMO_CLIENT_ADDRESS=

# ---- model (extractor + planner) ----
MODEL_API_KEY=            # unset: offline rules provider (tests, CI)
MODEL_PROVIDER=           # anthropic (default when MODEL_API_KEY is set) or rules
MODEL_NAME=               # default claude-opus-5-5; team decision pending (PLAN.md §2)

# ---- data sources ----
HKO_WARNSUM_URL=https://data.weather.gov.hk/weatherAPI/opendata/weather.php?dataType=warnsum&lang=en
GDACS_EVENTS_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH

# ---- FISCO BCOS (Yagi replay, stretch) ----
FISCO_RPC=http://127.0.0.1:8545
FISCO_CHAIN_ID=
